{
  "crons": [
    {
      "path": "/api/cron-push",
      "schedule": "0 7,10,13,16 * * *"
    },
    {
      "path": "/api/cron-reset",
      "schedule": "0 19 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
